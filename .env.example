# Names only — copy to .env.local (untracked) and fill in from meta/setup-guide.md §7.
# Never commit real values.

# Supabase project (dev: ats-dev, prod: ats-prod)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used only by the account-deletion action.
SUPABASE_SERVICE_ROLE_KEY=

# Transaction pooler, port 6543 (app queries)
DATABASE_URL=
# Session pooler, port 5432 (local/CI migrations only, not in Vercel)
MIGRATION_DATABASE_URL=

# Gemini (AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL_PRIMARY=gemini-2.5-flash
GEMINI_MODEL_FALLBACK=gemini-2.5-flash-lite
AI_ENABLED=true
# 1 only in tests with mocked AI
AI_MOCK=

ENGINE_VERSION=1.0.0
PROMPT_VERSION=1

# http://localhost:3000 locally, the Vercel URL in production
APP_URL=http://localhost:3000

# 1 only for CI / builds without secrets: skips validation in src/lib/env.ts
SKIP_ENV_VALIDATION=
